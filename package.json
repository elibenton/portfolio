{
	"name": "portfolio",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "CF_PAGES=1 vite build",
		"preview": "vite preview",
		"dev:cf": "wrangler pages dev .svelte-kit/cloudflare",
		"build:cf": "CF_PAGES=1 vite build",
		"deploy:cf": "CF_PAGES=1 vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name=$CLOUDFLARE_PAGES_PROJECT",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.4",
		"wrangler": "^4.149.0"
	},
	"type": "module",
	"packageManager": "pnpm@8.15.4+sha1.c85a4305534f76d461407b59277b954bac97b5c4",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
